# Copy to .env (git-ignored). Never paste real values into a Claude chat.
# Everything is optional: with no file at all the desk runs in PAPER mode on public market data.

# PAPER | BINANCE_DEMO | LIVE
TRADING_MODE=PAPER
# LIVE additionally needs this flag, an approved risk policy and `python -m trader live-unlock`
LIVE_TRADING_ENABLED=false

# Binance Demo Mode keys (create at https://demo.binance.com -> API Management)
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# Binance production keys. Spot trading only, NO withdrawal permission, IP-restricted.
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# Optional web search providers for the MCP research tools
TAVILY_API_KEY=
BRAVE_API_KEY=

# Optional: override where runtime data is stored (default: ./data)
# TRADER_DATA_DIR=
